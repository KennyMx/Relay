{
  "openapi": "3.0.3",
  "info": {
    "title": "Relay API",
    "version": "1.0.0",
    "description": "Self-hosted, non-streaming text chat gateway. Prices are estimated nano-USD. Bodies are limited to 64 KiB; unknown request fields are rejected. System messages must precede conversation messages and at least one user message is required."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local gateway"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Check PostgreSQL and Redis readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": []
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Create a non-streaming text completion",
        "security": [
          {
            "relayKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "object": {
                      "type": "string",
                      "enum": [
                        "chat.completion"
                      ]
                    },
                    "created": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0
                    },
                    "route": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    },
                    "choices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": {
                            "type": "integer",
                            "format": "int64",
                            "minimum": 0
                          },
                          "message": {
                            "$ref": "#/components/schemas/Message"
                          }
                        },
                        "required": []
                      }
                    },
                    "usage": {
                      "$ref": "#/components/schemas/Usage"
                    },
                    "latency_ms": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0
                    },
                    "cost_nano_usd": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0
                    },
                    "fallback_count": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0
                    },
                    "routing": {
                      "$ref": "#/components/schemas/RoutingDecision"
                    }
                  },
                  "required": []
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                },
                "description": "Ledger request identifier"
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "description": "Remaining whole request tokens"
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Per-key request quota exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before another token is available"
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Configured route alias; omitted selects default route."
                  },
                  "provider": {
                    "type": "string",
                    "description": "Start at this configured provider and retain later fallback targets."
                  },
                  "messages": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/Message"
                    }
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8192,
                    "default": 256
                  }
                },
                "required": [
                  "messages"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "description": "Use model=auto for complexity classification, or a configured route alias to bypass it. An explicit provider with auto bypasses classification and selects within the configured fallback route. Classification cost is separate from completion cost."
      }
    },
    "/v1/routes": {
      "get": {
        "summary": "List configured routes and current key",
        "security": [
          {
            "relayKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "default_route": {
                      "type": "string"
                    },
                    "key": {
                      "$ref": "#/components/schemas/Key"
                    },
                    "routes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "targets": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "provider": {
                                  "type": "string"
                                },
                                "model": {
                                  "type": "string"
                                }
                              },
                              "required": []
                            }
                          }
                        },
                        "required": []
                      }
                    }
                  },
                  "required": []
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/requests": {
      "get": {
        "summary": "List this key's request ledger, newest first",
        "security": [
          {
            "relayKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Record"
                      }
                    },
                    "limit": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0
                    },
                    "offset": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0
                    }
                  },
                  "required": []
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ]
      }
    },
    "/v1/requests/{id}": {
      "get": {
        "summary": "Read this key's request and ordered attempts",
        "security": [
          {
            "relayKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Record"
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/keys": {
      "post": {
        "summary": "Create a key; raw api_key is returned only once",
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Key"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "api_key": {
                          "type": "string"
                        }
                      },
                      "required": []
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "requests_per_minute": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "burst": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  }
                },
                "required": [
                  "name",
                  "requests_per_minute",
                  "burst"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/keys/{id}": {
      "delete": {
        "summary": "Revoke a Relay key",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Key revoked"
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "relayKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Relay API key (rl_live_...)"
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Generated RELAY_ADMIN_TOKEN; key administration only"
      }
    },
    "schemas": {
      "Usage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "simulated": {
            "type": "boolean"
          }
        },
        "required": [
          "input_tokens",
          "output_tokens",
          "total_tokens",
          "simulated"
        ]
      },
      "Key": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "requests_per_minute": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "burst": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": []
      },
      "Record": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "route": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "latency_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cost_nano_usd": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "success",
              "error"
            ]
          },
          "error_code": {
            "type": "string"
          },
          "fallback_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attempt"
            }
          },
          "routing": {
            "$ref": "#/components/schemas/RoutingDecision"
          }
        },
        "required": []
      },
      "Attempt": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "latency_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "status": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "cost_nano_usd": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": []
      },
      "Message": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Classification": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "local",
              "jev"
            ]
          },
          "tier": {
            "type": "string",
            "enum": [
              "simple",
              "standard",
              "complex"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "model": {
            "type": "string"
          },
          "latency_ms": {
            "type": "integer"
          },
          "cost_nano_usd": {
            "type": "integer"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "RoutingDecision": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "explicit"
            ]
          },
          "route": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "classification": {
            "$ref": "#/components/schemas/Classification"
          }
        }
      }
    }
  }
}
