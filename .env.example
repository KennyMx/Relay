# Generate .env with `relay init` as described in README. Never commit it.
# Empty credentials intentionally prevent startup; there is no shared password.
RELAY_ADMIN_TOKEN=
POSTGRES_PASSWORD=
RELAY_PORT=8080
RELAY_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Leave empty for $0 mock-only development.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Explicit opt-in: jev sends prompts to TypeSafe and may consume API credits.
RELAY_CLASSIFIER=local
JEV_API_KEY=
