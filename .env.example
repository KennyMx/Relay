# Generate .env with `relay init` as described in README. Never commit it.
# Empty credentials intentionally prevent startup; there is no shared password.
RELAY_ADMIN_TOKEN=
POSTGRES_PASSWORD=
RELAY_PORT=8080
RELAY_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Keep file mode for the free mock routes. Set real to use the simple
# provider setup below instead of editing config/relay.json.
RELAY_MODE=file
# Real mode: choose your own available model IDs and current prices in USD
# per million tokens. Add a different fallback provider only if needed.
RELAY_PRIMARY_PROVIDER=
RELAY_PRIMARY_MODEL=
RELAY_PRIMARY_INPUT_USD_PER_M=
RELAY_PRIMARY_OUTPUT_USD_PER_M=
RELAY_FALLBACK_PROVIDER=
RELAY_FALLBACK_MODEL=
RELAY_FALLBACK_INPUT_USD_PER_M=
RELAY_FALLBACK_OUTPUT_USD_PER_M=
# Leave empty for $0 mock-only development.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Explicit opt-in: jev sends prompts to TypeSafe and may consume API credits.
RELAY_CLASSIFIER=local
JEV_API_KEY=
