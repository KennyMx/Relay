{
  "default_route": "chat",
  "request_timeout_ms": 10000,
  "attempt_timeout_ms": 500,
  "max_attempts": 3,
  "providers": {
    "mock": {
      "kind": "mock",
      "scenario": "success"
    },
    "mock-rate-limit": {
      "kind": "mock",
      "scenario": "429"
    },
    "mock-failure": {
      "kind": "mock",
      "scenario": "500"
    },
    "mock-timeout": {
      "kind": "mock",
      "scenario": "timeout"
    }
  },
  "routes": {
    "chat": {
      "targets": [
        {
          "provider": "mock",
          "model": "mock-v1"
        }
      ]
    },
    "fallback-rate-limit": {
      "targets": [
        {
          "provider": "mock-rate-limit",
          "model": "mock-v1"
        },
        {
          "provider": "mock",
          "model": "mock-v1"
        }
      ]
    },
    "fallback-server-error": {
      "targets": [
        {
          "provider": "mock-failure",
          "model": "mock-v1"
        },
        {
          "provider": "mock",
          "model": "mock-v1"
        }
      ]
    },
    "fallback-timeout": {
      "targets": [
        {
          "provider": "mock-timeout",
          "model": "mock-v1"
        },
        {
          "provider": "mock",
          "model": "mock-v1"
        }
      ]
    },
    "unavailable": {
      "targets": [
        {
          "provider": "mock-failure",
          "model": "mock-v1"
        }
      ]
    },
    "fast": {
      "targets": [
        {
          "provider": "mock",
          "model": "mock-fast"
        }
      ]
    },
    "balanced": {
      "targets": [
        {
          "provider": "mock",
          "model": "mock-balanced"
        }
      ]
    },
    "reasoning": {
      "targets": [
        {
          "provider": "mock",
          "model": "mock-reasoning"
        }
      ]
    }
  },
  "pricing": {
    "mock/mock-v1": {
      "input_nano_usd_per_token": 1000,
      "output_nano_usd_per_token": 2000
    },
    "mock-rate-limit/mock-v1": {
      "input_nano_usd_per_token": 1000,
      "output_nano_usd_per_token": 2000
    },
    "mock-failure/mock-v1": {
      "input_nano_usd_per_token": 1000,
      "output_nano_usd_per_token": 2000
    },
    "mock-timeout/mock-v1": {
      "input_nano_usd_per_token": 1000,
      "output_nano_usd_per_token": 2000
    },
    "mock/mock-fast": {
      "input_nano_usd_per_token": 100,
      "output_nano_usd_per_token": 200
    },
    "mock/mock-balanced": {
      "input_nano_usd_per_token": 1000,
      "output_nano_usd_per_token": 2000
    },
    "mock/mock-reasoning": {
      "input_nano_usd_per_token": 5000,
      "output_nano_usd_per_token": 10000
    }
  },
  "auto_routing": {
    "routes": {
      "simple": "fast",
      "standard": "balanced",
      "complex": "reasoning"
    },
    "fallback_route": "balanced",
    "timeout_ms": 1500,
    "min_confidence": 0.65,
    "model": "jev-latest",
    "input_nano_usd_per_token": 42,
    "output_nano_usd_per_token": 0
  }
}
